#!/bin/bash

fixerrexit()
{
	( eval "expr '$-' : '.*e' >/dev/null && set -e; $*"; )
}

bash_scriptdir()
{
	dirname "$(readlink -f "${BASH_SOURCE[-1]}")"
}

ECHO()
{
	printf %s "$*"
}

bash_assign_global()
{
	declare -a varnames
	while [ $# != 0 ]
	do
		if [ "$1" = -- ]
		then
			shift
			break
		fi
		varnames+=("$1")
		shift
	done
	local varname
	for varname in "${varnames[@]}"
	do
		declare -g "$varname=${1:-}"
		shift
	done
	if [ ${BASH_ASSIGN_GLOBAL_GREEDY:-0} = 1 -a $# -gt 0 ]
	then
		declare -g "$varname=${!varname}${IFS:0:1}$*"
	fi
}

bash_assign_global_greedy()
{
	BASH_ASSIGN_GLOBAL_GREEDY=1 bash_assign_global "$@"
}
