#!/bin/sh

exec gtabdata --appinstance dig --title "dig $*" \
	--data-script "dig $* | grep -Ev '^(;|\$)' | td-trans -c 5 |
		td-add-headers NAME TTL CLASS TYPE CONTENT | td-alter NAME_CLASS_TYPE='join _,NAME,CLASS,TYPE' | td-alter KEY='(NAME_CLASS_TYPE)._.(++\$N{(NAME_CLASS_TYPE)})'" \
	--key-field KEY
