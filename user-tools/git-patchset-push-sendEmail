#!/usr/bin/env bash

set -euo pipefail

params=$*

set -f	# params must word-split into flags but never glob-expand against cwd
sendEmail -f anon@$RANDOM.$RANDOM -u "git:${PWD##*/}:$GIT_PATCHSET_REFRANGE" $params

