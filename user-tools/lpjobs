#!/bin/bash

true <<'EOF'
=pod

=head1 NAME

lpjobs [PRINTER] - Show printer queue jobs (wrapper for lpq and lpstat) in tabular format.

=cut

EOF


TAB=$'\t'

lpq_short_list_to_td()
{
	# lpq prints in "%-7s %-7.7s %-7d %-31.31s %.0f bytes" format,
	# so we insert tabs in netween the fields.
	perl -ne 'print join("\t", map {s/\s*$//r} /^(.{7}) (.{7}) (.{7}) (.{31}) (\S+)/), "\n"'
}

init_cache()
{
	local global_var=$1
	local cachefile=$2
	if declare -p "${global_var}_file" >/dev/null 2>/dev/null
	then
		# already initialized
		return 0
	fi
	declare -g "${global_var}_file"
	eval "${global_var}_file=\$cachefile"
	declare -g -A "$global_var"
	local key value
	if [ -s "$cachefile" ]
	then
		while IFS=$'\t' read -r key value
		do
			eval "$global_var[\$key]=\$value"
		done < "$cachefile"
	fi
}

cache_retrieve()
{
	local global_var=$1
	local key=$2
	local output_var=$3
	local exists
	eval "exists=\${$global_var[\$key]+yes}"
	if [ "$exists" = yes ]
	then
		eval "printf -v $output_var %s \"\${$global_var[\$key]}\""
	else
		return 1
	fi
}

cache_set()
{
	local global_var=$1
	local key=$2
	local value=$3
	eval "$global_var[\$key]=\$value"
	local cachefile
	eval "cachefile=\${${global_var}_file}"
	mkdir -p "${cachefile%/*}"
	printf '%s\t%s\n' "$key" "$value" >> "$cachefile"
}



TRG_PRINTER=$1

if [ -z "$TRG_PRINTER" ]
then
	LANG=C lpq -a
else
	LANG=C lpq -P "$TRG_PRINTER" | sed -e 1d
fi |\
sed -e '/^no entries$/ d' |\
lpq_short_list_to_td |\
ifne td-select -H Job Rank 'File(s)' |\
{
	declare -a job_rank
	declare -a job_filename
	declare -a job_printer
	declare -a job_datetime
	declare -A jobs
	
	echo "JOB${TAB}PRINTER${TAB}COMPLETED${TAB}RANK${TAB}DATETIME${TAB}FILE"
	
	# load printer queue jobs from lpq
	while read -r jobid rank filename
	do
		job_rank[$jobid]=$rank
		job_filename[$jobid]=$filename
		jobs[$jobid]=1
	done
	
	# load printer queue (completed and non-completed) jobs from lpstat
	for completeness in not-completed completed
	do
		LANG=C lpstat -R -W "$completeness" -o ${TRG_PRINTER:+"$TRG_PRINTER"} |\
		td-trans -c 5 |\
		td-add-headers -X RANK PRINTERJOBID USER SIZE DATETIME |\
		td-alter -B 'use DateTime::Format::Strptime; $dtparser = DateTime::Format::Strptime->new(pattern=>"%a %b %d %T %Y", on_error=>"croak", locale=>"C")' \
			_='($printer, $jobid) = PRINTERJOBID =~ /^(.+?)-(\d+)$/' \
			PRINTER='$printer' JOBID='$jobid' \
			COMPLETED="\"$completeness\"" \
			DATETIME='$dtparser->parse_datetime(DATETIME)->strftime("%F %T")' |\
		ifne td-select -H JOBID RANK COMPLETED PRINTER DATETIME
	done |\
	{
		while read -r jobid rank completeness printer datetime
		do
			job_printer[$jobid]=$printer
			job_datetime[$jobid]=$datetime
			job_completeness[$jobid]=$completeness
			if [ -z "${job_rank[$jobid]}" ]
			then
				job_rank[$jobid]=$rank
			fi
			if [ -z "${job_filename[$jobid]}" ]
			then
				init_cache JOBNAME_CACHE ~/.cache/lpjobs/cups-jobname
				if ! cache_retrieve JOBNAME_CACHE "$jobid" jobname
				then
					jobid_pad5=`printf %05d "$jobid"`
					jobname=`ippdump /var/spool/cups/c$jobid_pad5 | grep -m1 ^job-attributes/job-name= | cut -d= -f2-`
					if [ -n "$jobname" ]
					then
						cache_set JOBNAME_CACHE "$jobid" "$jobname"
					fi
				fi
				job_filename[$jobid]=$jobname
			fi
			jobs[$jobid]=1
		done
		
		for jobid in `printf '%s\n' "${!jobs[@]}" | sort -n`
		do
			echo "$jobid${TAB}${job_printer[$jobid]}${TAB}${job_completeness[$jobid]}${TAB}${job_rank[$jobid]}${TAB}${job_datetime[$jobid]}${TAB}${job_filename[$jobid]}"
		done
	}
}
