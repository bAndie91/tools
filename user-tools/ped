#!/usr/bin/perl

=pod

=head1 NAME

ped - programmatic file editor in perl

=head1 SYNOPSIS

ped [I<OPTIONS>] I<EXPRESSION> I<FILE>

=head1 DESCRIPTION

Edit I<FILE> by evaluating I<EXPRESSION> on the file contents.
The whole file's content is available in the C<$_> variable,
and, after I<EXPRESSION> is evaluated, C<$_> is written back to the file.

=head1 OPTIONS

=over 4

=item -i, --inplace

Write I<FILE> in place.
It's not always safe - see S<CAVEATS> below.
By default, the file is replaced by an atomic (rename) operation,
keeping the permission (file mode) of the original file,
but not owner/group, SELinux context, ACLs, or other extended attributes.

=back

=head1 CAVEATS

In in-place mode, the atomic file-write is not guaranteed:
the resulted file may be cut in half if the ped(1) dies midway.

=head1 SEE ALSO

sed(1), ed(1), ex(1), awk(1)

=cut


use Fcntl qw(:DEFAULT :flock SEEK_SET);
use File::Basename qw(dirname basename);
use File::Temp qw(tempfile);
use Errno qw(EINTR);
use Getopt::Long qw/:config no_ignore_case no_bundling no_getopt_compat no_auto_abbrev pass_through permute/;

my $PedOptInplace = 0;

GetOptions(
        'i|inplace!' => \$PedOptInplace,
        'help' => sub { pod2usage(-exitval=>0, -verbose=>99); },
        '<>' => sub { unshift @ARGV, $_[0]; die '!FINISH'; },
) or pod2usage(-exitval=>2, -verbose=>99);

my ($PedExpr, $PedFile) = @ARGV or pod2usage(-exitval=>2, -verbose=>99);

sysopen($PedInFH, $PedFile, O_RDWR) or die "$0: $PedFile: $!\n";
flock($PedInFH, LOCK_EX) or die "$0: flock: $PedFile: $!\n";

local $/;
$_ = <$PedInFH>;
defined $_ or die "$0: read: $PedFile: $!\n";

eval $PedExpr;
die "$0: eval: $@" if $@;
my $PedNewContent = $_;


my ($PedOutFH, $PedOutFilename);

if (!$PedOptInplace)
{
    my @st = stat($PedInFH);
    ($PedOutFH, $PedOutFilename) = tempfile(
        '.' . basename($PedFile) . '.XXXXXX',
        DIR => dirname($PedFile),
        UNLINK => 0,
    );

    chmod($st[2] & 07777, $PedOutFilename)
        or die "$0: chmod: $PedOutFilename: $!\n";
}
else
{
    $PedOutFH = $PedInFH;
    $PedOutFilename = $PedFile;

    seek($PedOutFH, 0, SEEK_SET)
        or die "$0: seek: $PedFile: $!\n";
}

my $ok = eval {
    my $offset = 0;
    while ($offset < length($PedNewContent))
    {
        my $n = syswrite($PedOutFH, $PedNewContent, length($PedNewContent) - $offset, $offset);
        next if !defined($n) && $! == EINTR;
        die "$0: write: $PedOutFilename: $!\n" unless defined($n) && $n > 0;
        $offset += $n;
    }

    if ($PedOptInplace)
    {
        truncate($PedOutFH, length($PedNewContent))
            or die "$0: truncate: $PedFile: $!\n";
    }
    else
    {
        $PedOutFH->sync or die "$0: $PedOutFilename: sync: $!\n";
        close($PedOutFH) or die "$0: $PedOutFilename: close: $!\n";
        rename($PedOutFilename, $PedFile)
            or die "$0: rename: $PedFile: $!\n";
    }

    1;
};

if (!$ok)
{
    my $error = $@ || "$0: $PedFile: unknown error\n";

    if (!$PedOptInplace)
    {
        close($PedOutFH);  # possibly already closed, ignore error.
        unlink($PedOutFilename);  # possibly already gone, ignore error.
    }

    die $error;
}
