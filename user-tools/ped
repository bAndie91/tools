#!/usr/bin/perl

=pod

=head1 NAME

ped - programmatic file editor in perl

=head1 SYNOPSIS

ped [I<OPTIONS>] I<EXPRESSION> I<FILE>

=head1 DESCRIPTION

Edit I<FILE> by evaluating I<EXPRESSION> on the file contents.
The whole file's content is available in the C<$_> variable,
and, after I<EXPRESSION> is evaluated, C<$_> is written back to the file.

=head1 OPTIONS

=over 4

=item -i, --inplace

Write I<FILE> in place.
It's not always safe - see S<CAVEATS> below.
By default, the file is replaced by an atomic (rename) operation,
keeping the permission (file mode) of the original file,
but not owner/group, SELinux context, ACLs, or other extended attributes.

=back

=head1 CAVEATS

In in-place mode, the atomic file-write is not guaranteed:
the resulted file may be cut in half if the ped(1) dies midway.

=head1 SEE ALSO

sed(1), ed(1), ex(1), awk(1)

=cut


use strict;
use warnings;
use Fcntl qw(:DEFAULT :flock SEEK_SET);
use File::Basename qw(dirname basename);
use File::Temp qw(tempfile);
use Errno qw(EINTR);
use Getopt::Long qw/:config no_ignore_case no_bundling no_getopt_compat no_auto_abbrev pass_through permute/;

my $OptInplace = 0;

GetOptions(
        'i|inplace!' => \$OptInplace,
        'help' => sub { pod2usage(-exitval=>0, -verbose=>99); },
        '<>' => sub { unshift @ARGV, $_[0]; die '!FINISH'; },
) or pod2usage(-exitval=>2, -verbose=>99);

my ($expr, $file) = @ARGV or pod2usage(-exitval=>2, -verbose=>99);

sysopen(my $fh, $file, O_RDWR) or die "$0: $file: $!\n";
flock($fh, LOCK_EX) or die "$0: flock: $file: $!\n";

local $/;
$_ = <$fh>;
defined $_ or die "$0: read: $file: $!\n";

eval $expr;
die "$0: eval: $@" if $@;
my $updated = $_;


my ($outfh, $outname);

if (!$OptInplace)
{
    my @st = stat($fh);
    ($outfh, $outname) = tempfile(
        '.' . basename($file) . '.XXXXXX',
        DIR => dirname($file),
        UNLINK => 0,
    );

    chmod($st[2] & 07777, $outname)
        or die "$0: chmod: $outname: $!\n";
}
else
{
    $outfh = $fh;
    $outname = $file;

    seek($outfh, 0, SEEK_SET)
        or die "$0: seek: $file: $!\n";
}

my $ok = eval {
    my $offset = 0;
    while ($offset < length($updated))
    {
        my $n = syswrite($outfh, $updated, length($updated) - $offset, $offset);
        next if !defined($n) && $! == EINTR;
        die "$0: write: $outname: $!\n" unless defined($n) && $n > 0;
        $offset += $n;
    }

    if ($OptInplace)
    {
        truncate($outfh, length($updated))
            or die "$0: truncate: $file: $!\n";
    }
    else
    {
        $outfh->sync or die "$0: $outname: sync: $!\n";
        close($outfh) or die "$0: $outname: close: $!\n";
        rename($outname, $file)
            or die "$0: rename: $file: $!\n";
    }

    1;
};

if (!$ok)
{
    my $error = $@ || "$0: $file: unknown error\n";

    if (!$OptInplace)
    {
        close($outfh);  # possibly already closed, ignore error.
        unlink($outname);  # possibly already gone, ignore error.
    }

    die $error;
}
